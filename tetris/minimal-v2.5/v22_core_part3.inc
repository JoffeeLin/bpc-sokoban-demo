static void observe_spawnpivot(SpawnPivot*p,const uint8_t pivot[N]){for(int oi=0;oi<N;oi++){uint32_t*q=pivot[oi]?&p->o[oi]:&p->z[oi];(*q)++;}}
static void train_spawnpivot(SpawnPivot*p,int ep){uint8_t prev[PREV]={0},active[N],pivot[N];prev[5]=1;for(int e=0;e<ep;e++){env_spawn_from_preview(prev,active,pivot);observe_spawnpivot(p,pivot);}}
static float spp(const SpawnPivot*p,int oi){uint32_t z=p->z[oi],o=p->o[oi];return((float)o+.5f)/((float)(z+o)+1.f);}
typedef struct{uint32_t z[2],o[2];}CellWave;typedef struct{uint32_t zbit[2][2],obit[2][2],zcar[2][2],ocar[2][2];}Prop;
static void train_cell(CellWave*m,int ep){for(int e=0;e<ep;e++)for(int x=0;x<2;x++){uint32_t*p=x?&m->o[x]:&m->z[x];(*p)++;}}
static float cp(const CellWave*m,int x){uint32_t z=m->z[x],o=m->o[x];return((float)o+.5f)/((float)(z+o)+1.f);}
static float rowc(const CellWave*m,const uint8_t*b,int y){float C=1.f;for(int x=0;x<W;x++)C*=cp(m,b[y*W+x]?1:0);return C;}
static void train_prop(Prop*p,int ep){for(int e=0;e<ep;e++)for(int u=0;u<2;u++)for(int c=0;c<2;c++){int bo=c?u:0,co=c?1:0;uint32_t*q=bo?&p->obit[u][c]:&p->zbit[u][c];(*q)++;q=co?&p->ocar[u][c]:&p->zcar[u][c];(*q)++;}}
static float pp(uint32_t z,uint32_t o){return((float)o+.5f)/((float)(z+o)+1.f);}
static void prop_step(const Prop*p,uint8_t*b,float*car,int cy){if(cy<=0){car[cy]=0;return;}float C=car[cy];for(int x=0;x<W;x++){int u=b[(cy-1)*W+x];float l=pp(p->zbit[u][1],p->obit[u][1]);b[cy*W+x]=(uint8_t)((C*l+(1-C)*b[cy*W+x])>.5f);b[(cy-1)*W+x]=(uint8_t)(((1-C)*u)>.5f);}car[cy-1]=C*pp(p->zcar[1][1],p->ocar[1][1]);car[cy]=0;}
static int clear_all_rows_model(const CellWave*c,const Prop*p,uint8_t*b){uint8_t before[N];memcpy(before,b,N);float born[H];for(int y=0;y<H;y++)born[y]=rowc(c,b,y);for(int row=0;row<H;row++){float car[H]={0};car[row]=born[row];for(int y=row;y>=0;y--)prop_step(p,b,car,y);}return !eq(before,b,N);}
typedef struct{uint8_t active[N],world[N],pivot[N],preview[PREV],gameover;}State;
static int pivot_xy(const uint8_t*p,int*x,int*y){for(int i=0;i<N;i++)if(p[i]){*x=i%W;*y=i/W;return 1;}return 0;}
static void setpivot(uint8_t*p,int x,int y){memset(p,0,N);if(x>=0&&x<W&&y>=0&&y<H)p[y*W+x]=1;}
static void real_clear(uint8_t*b){for(int y=H-1;y>=0;y--){int full=1;for(int x=0;x<W;x++)full&=b[y*W+x];if(full){for(int yy=y;yy>0;yy--)memcpy(b+yy*W,b+(yy-1)*W,W);memset(b,0,W);y++;}}}
static void real_spawn(State*s){uint8_t cand[N]={0};int blocked=0;for(int sy=0;sy<4;sy++)for(int sx=0;sx<4;sx++)if(s->preview[sy*4+sx]){int x=3+sx,y=-1+sy;if(y>=0&&y<H){cand[y*W+x]=1;if(s->world[y*W+x])blocked=1;}}memset(s->active,0,N);memset(s->pivot,0,N);s->gameover=(uint8_t)blocked;if(!blocked){memcpy(s->active,cand,N);setpivot(s->pivot,4,0);}}
static int real_move(State*s,int dir,int lock_on_fail){int blocked=0;for(int y=0;y<H;y++)for(int x=0;x<W;x++)if(s->active[y*W+x]){int tx=x+MDX[dir],ty=y+MDY[dir];if(tx<0||tx>=W||ty<0||ty>=H||s->world[ty*W+tx])blocked=1;}if(blocked){if(lock_on_fail){for(int i=0;i<N;i++)if(s->active[i])s->world[i]=1;memset(s->active,0,N);memset(s->pivot,0,N);real_clear(s->world);real_spawn(s);return 1;}return 0;}uint8_t a[N]={0},piv[N]={0};for(int y=0;y<H;y++)for(int x=0;x<W;x++){if(s->active[y*W+x])a[(y+MDY[dir])*W+x+MDX[dir]]=1;if(s->pivot[y*W+x])piv[(y+MDY[dir])*W+x+MDX[dir]]=1;}memcpy(s->active,a,N);memcpy(s->pivot,piv,N);return 0;}
static int real_rot(State*s){int cx,cy;if(!pivot_xy(s->pivot,&cx,&cy))return 0;uint8_t a[N]={0};int blocked=0;for(int y=0;y<H;y++)for(int x=0;x<W;x++)if(s->active[y*W+x]){int dx=x-cx,dy=y-cy,tx=cx-dy,ty=cy+dx;if(tx<0||tx>=W||ty<0||ty>=H||s->world[ty*W+tx])blocked=1;else a[ty*W+tx]=1;}if(!blocked)memcpy(s->active,a,N);return 0;}
static int real_step(State*s,int act){if(s->gameover)return 0;if(act==ACT_LEFT)return real_move(s,0,0);if(act==ACT_RIGHT)return real_move(s,1,0);if(act==ACT_DOWN)return real_move(s,2,1);if(act==ACT_ROT)return real_rot(s);if(act==ACT_DROP){for(int k=0;k<64;k++)if(real_move(s,2,1))return 1;}return 0;}
typedef struct{Move mv;MoveBlock mb;Rot rot;RotBlock rb;Couple cp;Spawn sp;SpawnPivot spiv;Couple sc;CellWave cw;Prop prop;}Model;
static void model_init(Model*m){memset(m,0,sizeof(*m));train_move(&m->mv,30);train_mblock(&m->mv,&m->mb,100);train_rot(&m->rot,100);train_rblock(&m->rot,&m->rb,100);train_couple(&m->cp,300);train_spawn(&m->sp,1000);train_spawnpivot(&m->spiv,300);train_couple(&m->sc,300);train_cell(&m->cw,30);train_prop(&m->prop,30);}
static void learned_spawn(const Model*m,const uint8_t prev[PREV],const uint8_t*world,uint8_t*a,uint8_t*piv,float g,uint8_t*gameover){float field[N];spawn_field(&m->sp,prev,field);float C=spawn_carrier(&m->sp,prev,world);float f0=C,f1=1.f-C;float gs=m->sc.w[0][0]*f0+m->sc.w[0][1]*f1;float gg=m->sc.w[1][0]*f0+m->sc.w[1][1]*f1;float spawn_gain=g*gs;float game_q=g*gg+(1.f-g)*(float)(*gameover);*gameover=(uint8_t)(game_q>.5f);for(int i=0;i<N;i++){float aq=spawn_gain*field[i]+(1.f-spawn_gain)*(float)a[i];float pq=spawn_gain*spp(&m->spiv,i)+(1.f-spawn_gain)*(float)piv[i];a[i]=(uint8_t)(aq>.5f);piv[i]=(uint8_t)(pq>.5f);}}
static float model_down_once(const Model*m,State*s){if(s->gameover)return 0.f;float C=move_carrier(&m->mv,&m->mb,s->active,s->world,2),gm,gl;cg(&m->cp,C,&gm,&gl);float ma[N],mpiv[N];shifted_probs(&m->mv,s->active,2,ma);shifted_probs(&m->mv,s->pivot,2,mpiv);uint8_t na[N]={0},npiv[N]={0};for(int i=0;i<N;i++){na[i]=(uint8_t)(gm*ma[i]>.5f);npiv[i]=(uint8_t)(gm*mpiv[i]>.5f);if(gl*(float)s->active[i]>.5f)s->world[i]=1;}memcpy(s->active,na,N);memcpy(s->pivot,npiv,N);float pending=gl;for(int micro=0;micro<H+8;micro++){uint8_t beforeA[N],beforeW[N],beforeP[N];uint8_t beforeG=s->gameover;memcpy(beforeA,s->active,N);memcpy(beforeW,s->world,N);memcpy(beforeP,s->pivot,N);learned_spawn(m,s->preview,s->world,s->active,s->pivot,pending,&s->gameover);(void)clear_all_rows_model(&m->cw,&m->prop,s->world);int changed=!eq(beforeA,s->active,N)||!eq(beforeW,s->world,N)||!eq(beforeP,s->pivot,N)||beforeG!=s->gameover;if(!changed)break;}return gl;}
static void model_move_lr(const Model*m,State*s,int dir){float C=move_carrier(&m->mv,&m->mb,s->active,s->world,dir);float ma[N],mp[N];shifted_probs(&m->mv,s->active,dir,ma);shifted_probs(&m->mv,s->pivot,dir,mp);for(int i=0;i<N;i++){s->active[i]=(uint8_t)((C*ma[i]+(1-C)*s->active[i])>.5f);s->pivot[i]=(uint8_t)((C*mp[i]+(1-C)*s->pivot[i])>.5f);}}
static void model_rot(const Model*m,State*s){int cx,cy;if(!pivot_xy(s->pivot,&cx,&cy))return;uint8_t in[SLOTS]={0},w[SLOTS]={0};for(int dy=-R;dy<=R;dy++)for(int dx=-R;dx<=R;dx++){int x=cx+dx,y=cy+dy,ii=lidx(dx,dy);if(x<0||x>=W||y<0||y>=H){w[ii]=1;continue;}in[ii]=s->active[y*W+x];w[ii]=s->world[y*W+x];}float C=1.f;for(int si=0;si<SLOTS;si++)if(in[si])C*=rot_go(&m->rot,&m->rb,si,w);float rb[SLOTS];rot_local_base(&m->rot,in,rb);uint8_t old[N];memcpy(old,s->active,N);for(int dy=-R;dy<=R;dy++)for(int dx=-R;dx<=R;dx++){int x=cx+dx,y=cy+dy;if(x<0||x>=W||y<0||y>=H)continue;int ii=lidx(dx,dy);s->active[y*W+x]=(uint8_t)((C*rb[ii]+(1-C)*old[y*W+x])>.5f);}}
static int model_step(const Model*m,State*s,int act){if(s->gameover)return 0;if(act==ACT_LEFT){model_move_lr(m,s,0);return 0;}if(act==ACT_RIGHT){model_move_lr(m,s,1);return 0;}if(act==ACT_DOWN)return model_down_once(m,s)>.5f;if(act==ACT_ROT){model_rot(m,s);return 0;}if(act==ACT_DROP){for(int k=0;k<64;k++)if(model_down_once(m,s)>.5f)return 1;}return 0;}
