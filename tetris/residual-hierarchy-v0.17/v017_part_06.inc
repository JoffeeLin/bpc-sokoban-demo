#define NB2 26
#define B2BITS 20
#define B2SZ (1u<<B2BITS)
#define B2MASK (B2SZ-1u)
typedef struct{float*w;unsigned long long writes;}D2Block;
static void d2i(D2Block*b){memset(b,0,sizeof(*b));b->w=calloc(B2SZ,sizeof(float));if(!b->w)exit(2);}static void d2f(D2Block*b){free(b->w);}
static uint16_t b16(const uint8_t*f,int bi){uint16_t v=0;int s=bi*16;for(int k=0;k<16;k++){int j=s+k;if(j<416)v|=(uint16_t)(f[j]&1u)<<k;}return v;}
static uint32_t d2addr(int bi,uint16_t bv,int j,uint32_t f2h){uint32_t h=0x7f4a7c15u;h=mix(h^(uint32_t)(bi+1)*0x85ebca6bu);h=mix(h^(uint32_t)bv*0xc2b2ae35u);h=mix(h^(uint32_t)(j+1)*0x27d4eb2du);h=mix(h^f2h);return h&B2MASK;}
static float d2pred_cached(const D2Block*b,const uint16_t bv[NB2],uint32_t f2h,int j){double s=0;const double inv=1.0/sqrt((double)NB2);for(int bi=0;bi<NB2;bi++)s+=b->w[d2addr(bi,bv[bi],j,f2h)];return(float)(s*inv);}
static void d2train(D2Block*b,const uint8_t*f,const float rw[F2D],const float*p2,const uint8_t*t){double en=0;for(int j=0;j<FRAME;j++){double e=(double)t[j]-p2[j];en+=e*e;}en=sqrt(en/FRAME);if(en<.004)return;uint16_t bv[NB2];for(int bi=0;bi<NB2;bi++)bv[bi]=b16(f,bi);uint32_t hh=f2hash(rw,211);float inv=(float)(1.0/sqrt((double)NB2));for(int j=0;j<FRAME;j++){float pr=d2pred_cached(b,bv,hh,j),e=(float)t[j]-p2[j]-pr,d=.24f*e*inv;for(int bi=0;bi<NB2;bi++){float*w=&b->w[d2addr(bi,bv[bi],j,hh)];*w+=d;if(*w>1.5f)*w=1.5f;if(*w<-1.5f)*w=-1.5f;b->writes++;}}}
static void p2base(const QC*q1,const Cache*c1,const QC*q2,const Cache*c2,const uint8_t*in,const float*fun,float p[FRAME]){predq(q1,c1,in,fun,p);for(int j=0;j<FRAME;j++){float rr=0;for(int b=0;b<BR;b++)rr+=q2->w[b][c2->a[b][j]];p[j]+=rr/BR;if(p[j]<.001f)p[j]=.001f;if(p[j]>.999f)p[j]=.999f;}}
static void eval17(const FC*fc,const QC*q1,const F2Cube*f2,const QC*q2,const D2Block*d2,int N,uint64_t seed,int mode,const char*tag){RNG r={seed};Game g;init(&g,ri(&r,7));Pilot po={0};uint8_t a[FRAME],t[FRAME];M m={0};unsigned long long ln=0,lf=0,lb=0,la=0,lp=0;for(int i=0;i<N;i++){if(g.game_over){init(&g,ri(&r,7));memset(&po,0,sizeof(po));}render(&g,a);int ac=pol(&g,&po,&r,1);int ev=step(&g,ac);render(&g,t);float fun[FD],p[FRAME],z[QD2],rw[F2D];Cache c1,c2;fw(fc,ac,fun);cache(a,fun,&c1);float p1[FRAME];predq(q1,&c1,a,fun,p1);qwave2(a,p1,fun,z);f2pred(f2,z,rw);if(mode==1)memset(rw,0,sizeof(rw));else if(mode==2)for(int k=0;k<F2D;k++)rw[k]=-rw[k];cache_f2(a,rw,&c2);p2base(q1,&c1,q2,&c2,a,fun,p);uint16_t bv[NB2];for(int bi=0;bi<NB2;bi++)bv[bi]=b16(a,bi);uint32_t hh=f2hash(rw,211);for(int j=0;j<FRAME;j++){float v=p[j]+d2pred_cached(d2,bv,hh,j);if(v<.001f)v=.001f;if(v>.999f)v=.999f;p[j]=v;}madd(&m,a,t,p,ev);if(ev&EV_LOCK){ln++;int ef=1,eb=1,ea=1,ep=1;for(int j=0;j<FRAME;j++)if((p[j]>=.5f)!=t[j])ef=0;for(int j=0;j<CELLS;j++)if((p[j]>=.5f)!=t[j])eb=0;for(int j=CELLS;j<CELLS*2;j++)if((p[j]>=.5f)!=t[j])ea=0;for(int j=400;j<416;j++)if((p[j]>=.5f)!=t[j])ep=0;lf+=ef;lb+=eb;la+=ea;lp+=ep;}}mp(tag,&m);printf("[%s lock] n=%llu full=%.2f board=%.2f active=%.2f preview=%.2f\n",tag,ln,100.0*lf/(ln?ln:1),100.0*lb/(ln?ln:1),100.0*la/(ln?ln:1),100.0*lp/(ln?ln:1));}
