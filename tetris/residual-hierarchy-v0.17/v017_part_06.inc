int v016_main(int argc,char**argv){int warm=argc>1?atoi(argv[1]):12000,q1s=argc>2?atoi(argv[2]):60000,f2s=argc>3?atoi(argv[3]):180000,q2s=argc>4?atoi(argv[4]):160000,N=argc>5?atoi(argv[5]):10000;FC fc={0};QC q1,q2;F2Cube f2={0};qi(&q1);qi(&q2);RNG r={0x1616ABCD};Game g;init(&g,ri(&r,7));Pilot po={0};uint8_t a[FRAME],t[FRAME];for(int i=0;i<warm;i++){if(g.game_over){init(&g,ri(&r,7));memset(&po,0,sizeof(po));}render(&g,a);int ac=pol(&g,&po,&r,1);step(&g,ac);render(&g,t);fobs(&fc,a,ac,t);}for(int i=0;i<q1s;i++){if(g.game_over){init(&g,ri(&r,7));memset(&po,0,sizeof(po));}render(&g,a);int ac=pol(&g,&po,&r,1);step(&g,ac);render(&g,t);float fun[FD];Cache c;fw(&fc,ac,fun);cache(a,fun,&c);trainq(&q1,&c,a,fun,t);}printf("DirectFit v0.16 D1->F2->Cube3 warm=%d q1=%d f2=%d q2=%d\n",warm,q1s,f2s,q2s);eval(&fc,&q1,N,0x1616A,0,"baseline");for(int i=0;i<f2s;i++){if(g.game_over){init(&g,ri(&r,7));memset(&po,0,sizeof(po));}render(&g,a);int ac=pol(&g,&po,&r,1);step(&g,ac);render(&g,t);float fun[FD],p1[FRAME],z[QD2],rt[F2D];Cache c;fw(&fc,ac,fun);cache(a,fun,&c);predq(&q1,&c,a,fun,p1);qwave2(a,p1,fun,z);dproj(t,p1,rt);f2train(&f2,z,rt);}for(int i=0;i<q2s;i++){if(g.game_over){init(&g,ri(&r,7));memset(&po,0,sizeof(po));}render(&g,a);int ac=pol(&g,&po,&r,1);step(&g,ac);render(&g,t);float fun[FD],p1[FRAME],z[QD2],rw[F2D];Cache c1,c2;fw(&fc,ac,fun);cache(a,fun,&c1);predq(&q1,&c1,a,fun,p1);qwave2(a,p1,fun,z);f2pred(&f2,z,rw);cache_f2(a,rw,&c2);train_q2(&q2,&c2,p1,t);}eval16(&fc,&q1,&f2,&q2,N,0x1616B,0,"f2-final");eval16(&fc,&q1,&f2,&q2,N,0x1616B,1,"F2-zero");eval16(&fc,&q1,&f2,&q2,N,0x1616B,2,"F2-flip");eval16(&fc,&q1,&f2,&q2,N,0x1616B,3,"F2-shift");qf(&q2);qf(&q1);return 0;}
